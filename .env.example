# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pusher (real-time)
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Site
NEXT_PUBLIC_SITE_URL=

# Logging
# LOG_LEVEL controls structured log verbosity: debug | info | warn | error
# Default: info in production, debug in development
LOG_LEVEL=info

# Request tracing
# Clients may send x-request-id header; if omitted, a UUID is generated per request.
# The ID is echoed back in the x-request-id response header and included in every JSON log line.
# No env var needed — the header is read automatically.

# Payment Service (payment gateway abstraction, Cloudflare Worker terpisah secara network)
# Provider aktif dikontrol PAYMENT_PROVIDER di worker (mock / pakasir).
# URL worker: http://localhost:8787 untuk dev lokal (wrangler dev), atau URL deploy di Cloudflare.
# Kosongkan untuk menonaktifkan payment service (alur invoice lama tanpa gateway).
PAYMENT_SERVICE_URL=

# Secret bersama dengan payment-service (.dev.vars / wrangler secret) untuk
# verifikasi signature webhook (HMAC-SHA256) di /api/webhooks/payment.
PAYMENT_WEBHOOK_SECRET=

# Feature flags (DB data source toggle)
# Set ke "true" untuk membaca dari database; selain itu memakai seed data.
# FS_PUBLIC_ARTICLES_DB_ENABLED=true
# FS_PUBLIC_REVIEWS_DB_ENABLED=true

# Cache revalidation (administrative purge)
# Secret untuk POST /api/revalidate (header x-revalidate-secret). Dipanggil admin
# (game-inventori, STORE_REVALIDATE_URL/STORE_REVALIDATE_SECRET) saat data berubah.
REVALIDATE_SECRET=